    "footer": "v1",               // Variante de pie de página
    "product_card": "v2",         // Variante de tarjeta de producto con acordeón
    "hero": "v2"                  // Variante con video 3D transparente (WebM)
  },

  // Interruptores de activación/desactivación de módulos en la interfaz
