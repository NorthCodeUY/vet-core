# apps/admin-portal/dockerfile
# Propósito: Multi-stage build para compilar Flutter Web y servirlo con Nginx con permisos de lectura globales.

# ==============================================================================
# ETAPA 1: COMPILACIÓN DEL CLIENTE FLUTTER WEB
# ==============================================================================
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /app

# 1. Copiar dependencias y resolver paquetes
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# 2. Copiar el código fuente completo
COPY . .

# 3. Compilar artefacto Web de producción
RUN flutter build web --release --base-href /

# ==============================================================================
# ETAPA 2: SERVIDOR NGINX DE PRODUCCIÓN (ZERO-REBUILD SILO)
# ==============================================================================
FROM nginx:1.27-alpine

RUN apk add --no-cache gettext

# Copiar artefactos web generados desde la Etapa 1
COPY --from=builder /app/build/web /usr/share/nginx/html

# <!> Garantiza permisos de lectura globales para el worker no-root de Nginx (evita HTTP 403 en config.json)
RUN chmod -R a+rX /usr/share/nginx/html

# Plantilla de NGINX con proxy dinámico
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]