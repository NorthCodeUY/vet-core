{
  // Control de versión del esquema de configuración
  "_version": "1.0.0",

  // Identificador único del cliente (usado para logs, cabeceras de API y Docker)
  "id": "malandro_barber",

  // Nombre comercial que se muestra en títulos de pestaña, header y pie de página
  "business_name": "Malandro Barber",

  // Eslogan institucional con formato segmentado
  "slogan": {
    "prefix": "Estilo clásico y",
    "highlight": "Tendencias Modernas",
    "suffix": "en Artigas"
  },

  // ===========================================================================
  // PALETA DE COLORES MULTI-TENANT (Modo Oscuro Premium / Rojo & Negro)
  // Valores estrictamente en formato Hexadecimal (#RRGGBB).
  // ===========================================================================
  "theme": {
    // 1. MARCA & LLAMADAS A LA ACCIÓN (CTA)
    "primary": "#d21919",         // Rojo intenso de marca (Botones de acción, enlaces, acentos)
    "primary_hover": "#801e1e",   // Rojo oscuro para el estado hover del botón
    "secondary": "#18181B",       // Gris carbón metálico (Badges y detalles)
    "tertiary": "#25D366",        // Verde oficial de WhatsApp
    // 2. FONDOS & ESTRUCTURA VISUAL
    "dark": "#090D16",            // Fondo oscuro estructural para header, footers y modales
    "surface": "#131C2E",         // Fondo para tarjetas y áreas de contenido
    "soft": "#1E293B",            // Fondo gris grafito para contraste suave
    "overlay": "#020617",         // Backdrop con oscurecimiento para modales
    // 3. JERARQUÍA TIPOGRÁFICA (Legibilidad en Fondo Oscuro)
    "text_base": "#FFFFFF",       // Texto principal de lectura y títulos (Blanco de alto contraste)
    "text_muted": "#94A3B8",      // Texto secundario, subtítulos y placeholders (Gris claro)
    // 4. BORDES & ALERTAS
    "border_subtle": "#1E293B",   // Líneas divisorias sutiles y bordes de tarjetas
    "error": "#DC2626"            // Color para alertas y cancelaciones
  },

  // Rutas estandarizadas de activos servidos desde la carpeta /tenant/
  "branding": {
    "logo_url": "/tenant/logo.png",
    "hero_animation_url": "/tenant/animations/hero_animation.json",
    "background_animation_url": "/tenant/barber_pole.webm"

