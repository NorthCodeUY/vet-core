  // ===========================================================================
  // PALETA DE COLORES: PALETTE 1 (MAGENTA PINK & JET BLACK)
  // ===========================================================================
  "theme": {
    // 1. MARCA & ACCIONES
    "primary": "#E6007E",         // Magenta Pink oficial (Botones de compra, enlaces activos, acentos)
    "primary_hover": "#BF0069",   // Tono magenta más profundo para estados hover
    "secondary": "#FDF2F8",       // Rosa pastel suave para alternar fondos de sección y badges
    "tertiary": "#25D366",        // Verde oficial para WhatsApp

    // 2. FONDOS & ESTRUCTURA
    "dark": "#000000",            // Jet Black (Header, footer y fondos de alto impacto)
    "surface": "#FFFFFF",         // Blanco puro para tarjetas de indumentaria y checkout
    "soft": "#FCE7F3",            // Tinte rosa claro para detalles sutiles
    "overlay": "#000000",         // Capa oscura para modales y drawer de pedidos

    // 3. JERARQUÍA TIPOGRÁFICA
    "text_base": "#000000",       // Jet Black de máximo contraste para títulos y precios
    "text_muted": "#71717A",      // Gris neutro para talles, descripciones y placeholders

    // 4. BORDES & ALERTAS
    "border_subtle": "#F4E8F0",   // Separadores sutiles que armonizan con el rosa
    "error": "#DC2626"            // Rojo para alertas o vaciar carrito
  },

  "branding": {
    "logo_url": "/tenant/logo.png",
    "hero_animation_url": "/tenant/animations/hero_animation.json"
  },

  "ui_variants": {
    "header": "v1",
    "footer": "v1",
    "product_card": "v2",
    "hero": "v1"
