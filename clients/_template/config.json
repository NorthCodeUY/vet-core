    "prefix": "Cuidado profesional para",
    "highlight": "Tus Mascotas",
    "suffix": "en Salto"
  },

  // ===========================================================================
  // PALETA DE COLORES MULTI-TENANT (Inyectada dinámicamente en :root del DOM)
  // Valores estrictamente en formato Hexadecimal (#RRGGBB).
  // ===========================================================================
  "theme": {
    // 1. MARCA & LLAMADAS A LA ACCIÓN (CTA)
    "primary": "#275D9E",         // Botones principales, enlaces activos, iconos destacados
    "primary_hover": "#1E4B82",   // Estado hover exclusivo del botón principal
    "secondary": "#daebd4",       // Color secundario (Badges, etiquetas, acentos de apoyo)
    "tertiary": "#1FAF38",        // Color exclusivo para canales de WhatsApp y llamadas
    // 2. FONDOS & ESTRUCTURA VISUAL
    "dark": "#004D40",            // Fondo estructural oscuro (Header, Footers, modales, draweres)
    "surface": "#FFFFFF",         // Fondo de tarjetas de producto, inputs y áreas de contenido
    "soft": "#DBECD5",            // Tinte suave de marca (Fondos de secciones alternadas, chips pasivos)
    "overlay": "#000000",         // Capa oscura para backdrop de modales y menús móviles
    // 3. JERARQUÍA TIPOGRÁFICA (Legibilidad)
    "text_base": "#000000",       // Texto principal de lectura y títulos (Alto contraste)
    "text_muted": "#64748B",      // Texto secundario, subtítulos, fechas y placeholders
    // 4. BORDES & ALERTAS
    "border_subtle": "#E2E8F0",   // Líneas divisorias suaves y bordes de tarjetas
    "error": "#DC2626"            // Acciones destructivas (Vaciar carrito, urgencias 24h, alertas)  
  },

  // Rutas estandarizadas de logotipos e iconos servidos desde la carpeta /tenant/
  "branding": {
    "logo_url": "/tenant/logo.png",
    "hero_animation_url": "/tenant/animations/hero_animation.json",
    "background_animation_url": "/tenant/barber_pole.webm"
  },

  // Selector de variantes de diseño para componentes modulares
  "ui_variants": {
    "header": "v1",               // Variante visual de la barra de navegación superior
    "footer": "v1",               // Variante visual del pie de página
    "product_card": "v2",         // Variante visual de la tarjeta de producto en el catálogo
    "hero": "v1",                 // Variante visual de la portada principal (v1: foto/modal, v2: cita, v3: lottie, v4: video 3D)
    "portfolio_card": "v1"        // Variante visual para tarjetas de galería o portafolio
  },

  // Interruptores de activación/desactivación de módulos en la interfaz (Features)
  "features": {
    "has_cart": true,                  // ✅ true: activa el carrito y drawer de pedidos | false: solo catálogo
