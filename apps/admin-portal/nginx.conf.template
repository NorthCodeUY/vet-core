# apps/admin-portal/nginx.conf.template
# Propósito: Servir la SPA Flutter Web y proxiar API y archivos multimedia estáticos hacia el silo FastAPI.

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 1. Inyección de Assets de Tenant
    location /assets/tenant/ {
        alias /usr/share/nginx/html/assets/tenant/;
        autoindex off;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # 2. Proxy Inverso dinámico hacia el Silo FastAPI
    location /api/ {
        proxy_pass http://${BACKEND_HOST}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # <!> 3. Proxy para archivos estáticos/imágenes servidos por FastAPI (antes del fallback SPA)
    location ~ ^/(static|uploads|media)/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Soporte para Enrutamiento SPA en Flutter Web
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}