# api-backend/.env.example

# ==============================================================================
# VETCORE - CONFIGURACIÓN DE ENTORNO (TEMPLATE)
# Instrucciones: Copiar este archivo como '.env' y completar los valores.
# No subir el archivo '.env' real al repositorio de Git.
# ==============================================================================

# --- CONFIGURACIÓN DE ENTORNO ---
# development: Habilita CORS abierto (*), logs detallados y detección de IP local.
# production: Habilita CORS estricto, seguridad JWT reforzada y requiere BASE_URL real.
ENV_MODE=development

# true: Si el backend corre dentro de un contenedor Docker (usa nombres de servicio para DB).
# false: Si el backend corre directamente en la terminal (usa localhost para DB).
IS_DOCKER=false

# --- CREDENCIALES DE BASE DE DATOS (PostgreSQL) ---
DB_USER=postgres_user 
DB_PASSWORD=secure_password_here 
DB_NAME=vet_core_db
# Host: Usar 'localhost' para terminal o el nombre del servicio (ej: 'db-vet_bel') para Docker.
DB_HOST=localhost DB_PORT=5432

# --- CONFIGURACIÓN DE RED ---

# Puerto interno donde escuchará el servidor FastAPI (Uvicorn).

APP_PORT=8000

# URL pública del Backend.
# En desarrollo: Se puede dejar vacío para autodetectar IP local.
# En producción: DEBE ser la URL real (ej: https://api.veterinaria-beltramelli.com).
BASE_URL=http://localhost:8000

# Orígenes permitidos para CORS (Separados por coma, sin espacios).
# Ejemplo: https://veterinaria-beltramelli.com,http://localhost:5173

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SEGURIDAD Y AUTENTICACIÓN (JWT) ---

# Clave secreta para firmar los tokens. Generar una fuerte con: openssl rand -hex 32
SECRET_KEY=generate_a_very_long_random_hex_string_here

# Algoritmo de cifrado (HS256 es el estándar para JWT).
ALGORITHM=HS256

# Tiempo de vida del token en minutos (480 min = 8 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ADMINISTRACIÓN DE BASE DE DATOS (PgAdmin) ---
# Credenciales para acceder al panel de control de la base de datos.
DBADMIN_EMAIL=admin@vetcore.com 
DBADMIN_PASSWORD=secure_admin_password

# ==============================================================================
# NOTA DE ARQUITECTURA:
# Este archivo es consumido por 'app/config.py' mediante Pydantic v2.
# Cualquier variable agregada aquí debe ser declarada en la clase 'Settings'.
# ==============================================================================
