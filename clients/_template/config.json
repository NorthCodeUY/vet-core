    "has_services": true,              // ✅ true: muestra la sección de servicios ofrecidos
    "has_health_plans": true,          // ✅ true: muestra la sección de planes, membresías o suscripciones
    "has_appointments": false,         // ❌ false: muestra módulo de reservas de turnos online
    "has_emergency_button": true,      // ✅ true: activa el botón de urgencias 24h en pantalla y mapas
    "has_portfolio": false,            // ❌ false: activa galería visual de trabajos realizados
    "has_locations": true,             // ✅ true: muestra la sección de ubicación física y mapa
    "has_hero": true,                  // ✅ true: muestra la sección principal de portada (Hero)
    "has_floating_bottom_bar": true,   // ✅  true: activa la barra flotante de accesos rápidos inferior
    "has_dividers": true,              // ✅ true: activa ondas curvas SVG entre secciones | false: diseño plano
    "has_background_animation": false  // ❌ false: activa animación 3D de fondo reactiva al scroll
  },

