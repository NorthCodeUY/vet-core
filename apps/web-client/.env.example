# apps/web-cliete/.env.example

# ==============================================================================
# VETCORE - CONFIGURACIÓN FRONTEND (VITE)
# Instrucciones: Copiar como '.env' en la raíz de 'apps/web-client/'.
# Nota: Las variables deben empezar con 'VITE_' para ser accesibles en el código.
# ==============================================================================

# --- CONFIGURACIÓN DE PUERTOS (Solo Desarrollo) ---
# Puerto donde corre el Backend (FastAPI).
# Usado por el Proxy de Vite para redirigir peticiones /api y /static.
VITE_BACKEND_PORT=8001

# Puerto donde corre este Frontend (Vite).
VITE_FRONTEN_PORT=5173

# --- RUTAS DE API Y ASSETS ---
# Prefijo para las llamadas a la API.
# En desarrollo, el proxy de Vite lo redirige al backend.
# En producción, Nginx redirige '/api' al contenedor del backend.
VITE_API_URL=/api

# Ruta base para las imágenes de productos.
# Se concatena con el nombre del archivo que viene de la base de datos.
VITE_API_IMAGES=/static/productos

# ==============================================================================
# NOTA DE DESPLIEGUE:
# En React/Vite, estas variables se inyectan durante el tiempo de COMPILACIÓN.
# Si cambias estos valores, debes ejecutar 'npm run build' nuevamente para
# que los cambios se reflejen en los archivos estáticos de producción.
# ==============================================================================
