# /apps/web-client/dockerfile

FROM node:22-alpine AS build-step

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Compila el código agnóstico sin variables atadas a clientes
RUN npm run build

# =============================================================================
# ETAPA 2: Servidor NGINX Dinámico
# =============================================================================
FROM nginx:stable-alpine

# Limpiar archivos base de Nginx
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copiar el build compilado
COPY --from=build-step /app/dist /usr/share/nginx/html

# Crear directorios de montaje
RUN mkdir -p /usr/share/nginx/html/config /usr/share/nginx/html/tenant /etc/nginx/templates

# INYECCIÓN LIMPIA: Copiar la plantilla directamente
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]