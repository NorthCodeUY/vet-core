    "has_emergency_button": false,// false: apaga botón de urgencias médicas
    "has_locations": true,        // true: muestra la ubicación y mapa del estudio
    "has_hero": true,             // true: muestra la portada principal
    "has_navbar_floating": false, // false: menú fijo tradicional
    "has_dividers": false,         // false: diseño plano moderno sin ondas de pasto
    "has_background_animation": true  // 👈 true: activa el cartel de fondo reactivo al scroll
